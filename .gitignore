# Python
backend/venv/
backend/__pycache__/
backend/app/__pycache__/
backend/app/**/__pycache__/
backend/*.db
backend/.env
*.pyc

# Node
frontend/node_modules/
frontend/dist/
frontend/e2e_smoke.mjs
frontend/*.png

# Build output copied into backend for single-service deploy
backend/static/

# OS / editor
.DS_Store
.vscode/*
# The four below encode project setup -- where the venv lives, which config
# ruff uses, which directory pytest runs from -- so they're shared. Anything
# else under .vscode/ is personal and stays ignored.
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

.verify-artifacts/

# local SQLite databases
*.db

# Python tooling caches
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/
