# Copy this file to .env for local development.
#
# ENVIRONMENT=production turns on startup safety checks: the app refuses to
# boot with the placeholder JWT secret or a SQLite database URL.
ENVIRONMENT=development

# In production (Render), these are set as environment variables instead.

# SQLAlchemy connection string. Render provides this automatically when you
# attach a Postgres database via render.yaml. For local dev you can point at
# a local Postgres, or leave unset to fall back to a local SQLite file.
DATABASE_URL=postgresql://sderadar:devpassword@localhost:5432/sderadar

# Any long random string. Render's render.yaml auto-generates one in prod.
JWT_SECRET=change-me-to-a-long-random-string

# Job board connectors — each is optional and independent. With NONE of
# these set, the app runs on a bundled seed job pool instead of live
# listings. Configure as many as you like; results from every active
# connector are merged and deduplicated into one shared job pool. See
# GET /api/sources to check which connectors are live at runtime.

# Adzuna — free credentials at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — free API key at https://jooble.org/api/about
JOOBLE_API_KEY=
# Per-company boards. All four are keyless: set comma-separated slugs for
# the employers you care about. The slug is the last path segment of that
# company's public careers URL on the ATS.
#   boards.greenhouse.io/stripe         -> stripe
#   jobs.lever.co/gopuff                -> gopuff
#   jobs.ashbyhq.com/ramp               -> ramp
#   jobs.smartrecruiters.com/BoschGroup -> BoschGroup   (case-sensitive)
GREENHOUSE_COMPANIES=
LEVER_COMPANIES=
ASHBY_COMPANIES=
SMARTRECRUITERS_COMPANIES=

# Remotive and Arbeitnow need no key — they're always on, no config needed.

# Comma-separated list of allowed origins, or "*" for any (fine for a
# single-service deploy where the frontend is served from the same origin).
CORS_ORIGINS=*

# How many proxies sit in front of the app and append to X-Forwarded-For.
# 0 (the default) means the header is ignored entirely, which is correct when
# you reach uvicorn directly in dev. Render sets this to 1 -- getting it wrong
# either ignores a trustworthy header (throttles harder than needed) or trusts
# a client-written one (throttle bypassable). Prefer too low over too high.
TRUSTED_PROXY_HOPS=0

# Login throttling. The first pair is the working limit, keyed on email+IP.
# The second is a much looser backstop keyed on email alone, so guessing
# against one account stays capped even from rotating addresses.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_EMAIL_RATE_LIMIT_ATTEMPTS=50
LOGIN_EMAIL_RATE_LIMIT_WINDOW_SECONDS=3600
