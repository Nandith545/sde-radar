# Copy this file to .env for local development.
# In production (Render), these are set as environment variables instead.

# SQLAlchemy connection string. Render provides this automatically when you
# attach a Postgres database via render.yaml. For local dev you can point at
# a local Postgres, or leave unset to fall back to a local SQLite file.
DATABASE_URL=postgresql://sderadar:devpassword@localhost:5432/sderadar

# Any long random string. Render's render.yaml auto-generates one in prod.
JWT_SECRET=change-me-to-a-long-random-string

# Job board connectors — each is optional and independent. With NONE of
# these set, the app runs on a bundled seed job pool instead of live
# listings. Configure as many as you like; results from every active
# connector are merged and deduplicated into one shared job pool. See
# GET /api/sources to check which connectors are live at runtime.

# Adzuna — free credentials at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — free API key at https://jooble.org/api/about
JOOBLE_API_KEY=

# Remotive and Arbeitnow need no key — they're always on, no config needed.

# Comma-separated list of allowed origins, or "*" for any (fine for a
# single-service deploy where the frontend is served from the same origin).
CORS_ORIGINS=*
