{
  // ---- Python -----------------------------------------------------------
  // The venv lives in backend/, not the repo root, so VS Code can't find it
  // by itself. On Windows change this to: backend/venv/Scripts/python.exe
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Tests live under backend/, so pytest has to run from there or it won't
  // resolve `from app import ...`.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],

  // ---- Formatting and linting -------------------------------------------
  // Ruff is the formatter AND the linter here, matching what CI enforces.
  // Format-on-save means `ruff format --check` in CI should never fail you.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.configuration": "${workspaceFolder}/backend/pyproject.toml",

  "[typescript]": { "editor.formatOnSave": true },
  "[typescriptreact]": { "editor.formatOnSave": true },
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ---- Noise reduction ---------------------------------------------------
  // Hidden from the file tree. Still on disk, just not in your way.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true,
    "backend/venv": true,
    "backend/static": true,
    ".verify-artifacts": true
  },
  // Excluded from search but still visible in the tree.
  "search.exclude": {
    "**/node_modules": true,
    "**/package-lock.json": true,
    "backend/alembic/versions/**": false
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/venv/**": true,
    "**/.git/objects/**": true
  },

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.rulers": [110],
  "git.autofetch": true
}
